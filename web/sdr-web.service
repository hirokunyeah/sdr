[Unit]
Description=RTL-SDR Web Receiver
After=network-online.target
Wants=network-online.target

[Service]
# ↓ ユーザー名とフォルダは自分の環境に合わせて書き換える（docs/install-raspberrypi.md 参照）
User=ubuntu
WorkingDirectory=/home/ubuntu/sdr/web
ExecStart=/home/ubuntu/sdr/web/venv/bin/python server.py --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
